# Public client configuration. EXPO_PUBLIC_* values are bundled and must never be secrets.
EXPO_PUBLIC_API_URL=http://localhost:4100

# API configuration. Copy to .env.local for development; do not commit real values.
KEYORA_PROFILE=local
API_HOST=127.0.0.1
API_PORT=4100
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
DATABASE_URL=postgresql://keyora_owner:keyora-owner-local-only@127.0.0.1:5432/keyora_test
MIGRATION_DATABASE_URL=postgresql://keyora_owner:keyora-owner-local-only@127.0.0.1:5432/keyora_test
DATABASE_TLS=false
LOG_LEVEL=info
