{
  "name": "keyora-stayos",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api:dev": "tsx watch apps/api/src/server.ts",
    "api:start": "tsx apps/api/src/server.ts",
    "api:smoke": "node scripts/smoke-api.cjs",
    "api:test": "tsx --test apps/api/test/app.test.ts",
    "api:performance": "tsx apps/api/test/performance.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx apps/api/src/database/migrate.ts up",
    "db:rollback": "tsx apps/api/src/database/migrate.ts down",
    "db:seed": "tsx apps/api/src/database/seed.ts",
    "db:seed-users": "tsx apps/api/src/database/seed-auth-users.ts",
    "db:seed-notifications": "tsx apps/api/src/database/seed-notification-templates.ts",
    "db:test": "tsx apps/api/test/database.integration.ts",
    "auth:test": "tsx apps/api/test/auth.integration.ts",
    "notifications:test": "tsx apps/api/test/notifications.integration.ts",
    "observability:test": "tsx apps/api/test/observability.integration.ts",
    "security:test": "tsx apps/api/test/security.integration.ts",
    "inventory:test": "tsx apps/api/test/inventory.integration.ts",
    "reservations:test": "tsx apps/api/test/reservations.integration.ts",
    "security:licenses": "node scripts/check-licenses.cjs",
    "notifications:worker": "tsx apps/api/src/notifications/worker.ts",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "contract:generate": "node scripts/generate-contract.cjs",
    "contract:validate": "node scripts/generate-contract.cjs --check && node scripts/validate-contract.cjs",
    "check": "npm run lint && npm run typecheck && npm run contract:validate && npm run test && npm run api:test"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@hookform/resolvers": "^6.0.1",
    "@node-rs/argon2": "^2.2.2",
    "@prometheus-io/client": "^0.16.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "lucide-react-native": "^1.62.0",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
