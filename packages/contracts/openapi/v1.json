{
  "openapi": "3.1.0",
  "info": {
    "title": "KEYORA StayOS API",
    "version": "1.0.0",
    "description": "Versioned, tenant-scoped contract shared by native and web clients."
  },
  "servers": [{ "url": "/", "description": "Environment-relative; origins are configured outside the contract." }],
  "security": [{ "session": [] }],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "security": [],
        "responses": { "200": { "description": "Process health", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } } }
      }
    },
    "/v1/ready": {
      "get": {
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": { "description": "Dependencies are ready to receive traffic", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadinessResponse" } } } },
          "503": { "description": "One or more dependencies are unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadinessResponse" } } } }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "login",
        "security": [],
        "x-idempotency-exempt": true,
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "Authenticated; web tokens are set only as HttpOnly cookies", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "security": [],
        "x-idempotency-exempt": true,
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } } },
        "responses": { "200": { "description": "Rotated session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/logout": {
      "post": { "operationId": "logout", "x-idempotency-exempt": true, "responses": { "204": { "description": "Session revoked and cookies cleared" } } }
    },
    "/v1/auth/password-reset/request": {
      "post": {
        "operationId": "requestPasswordReset", "security": [], "x-idempotency-exempt": true,
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetRequest" } } } },
        "responses": { "202": { "description": "Always accepted to prevent account enumeration" } }
      }
    },
    "/v1/auth/password-reset/confirm": {
      "post": {
        "operationId": "confirmPasswordReset", "security": [], "x-idempotency-exempt": true,
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetConfirm" } } } },
        "responses": { "204": { "description": "Password replaced and every session revoked" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/properties/{propertyId}/notifications/preview": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "post": { "operationId": "previewNotification", "x-idempotency-exempt": true, "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreviewRequest" } } } }, "responses": { "200": { "description": "Rendered without sending", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreview" } } } }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/properties/{propertyId}/notifications/events": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "post": { "operationId": "enqueueNotificationEvent", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationEventRequest" } } } }, "responses": { "202": { "description": "Event accepted idempotently" }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/properties/{propertyId}/notifications/deliveries": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "get": { "operationId": "listNotificationDeliveries", "responses": { "200": { "description": "Tenant-scoped redacted delivery history" }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/properties/{propertyId}/notification-preferences/me": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "get": { "operationId": "getMyNotificationPreferences", "responses": { "200": { "description": "Current user preferences", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreferences" } } } } } },
      "put": { "operationId": "updateMyNotificationPreferences", "x-idempotency-exempt": true, "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreferences" } } } }, "responses": { "204": { "description": "Preferences updated" } } }
    },
    "/v1/notification-providers/primary/callback": {
      "post": { "operationId": "receiveNotificationCallback", "security": [], "x-idempotency-exempt": true, "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationCallback" } } } }, "responses": { "204": { "description": "Authenticated callback accepted idempotently" }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/properties/{propertyId}/rooms": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "get": {
        "operationId": "listRooms",
        "responses": {
          "200": { "description": "Property-scoped rooms", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoomPage" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/properties/{propertyId}/reservations": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "get": {
        "operationId": "listReservations",
        "responses": {
          "200": { "description": "Property-scoped reservations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReservationPage" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createReservation",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateReservationCommand" } } } },
        "responses": {
          "201": { "description": "Reservation created exactly once", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reservation" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Native access token. Web uses an HttpOnly session cookie with the same authorization claims." }
    },
    "parameters": {
      "PropertyId": { "name": "propertyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "Error": { "description": "Safe error envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
    },
    "schemas": {
      "HealthResponse": { "type": "object", "additionalProperties": false, "required": ["status", "version"], "properties": { "status": { "const": "ok" }, "version": { "type": "string" } } },
      "ReadinessResponse": { "type": "object", "additionalProperties": false, "required": ["status", "version"], "properties": { "status": { "enum": ["ready", "unavailable"] }, "version": { "type": "string" } } },
      "Money": { "type": "object", "additionalProperties": false, "required": ["amountMinor", "currency"], "properties": { "amountMinor": { "type": "integer", "minimum": 0 }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } } },
      "Room": { "type": "object", "additionalProperties": false, "required": ["id", "organizationId", "propertyId", "name", "roomType", "capacity", "status", "version", "updatedAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "organizationId": { "type": "string", "format": "uuid" }, "propertyId": { "type": "string", "format": "uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "roomType": { "type": "string", "minLength": 1, "maxLength": 80 }, "capacity": { "type": "integer", "minimum": 1, "maximum": 50 }, "status": { "enum": ["available", "occupied", "cleaning", "maintenance"] }, "version": { "type": "integer", "minimum": 1 }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "GuestSummary": { "type": "object", "additionalProperties": false, "required": ["id", "displayName", "vip"], "properties": { "id": { "type": "string", "format": "uuid" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 160 }, "vip": { "type": "boolean" } } },
      "Reservation": { "type": "object", "additionalProperties": false, "required": ["id", "organizationId", "propertyId", "roomId", "guest", "checkIn", "checkOut", "adults", "children", "status", "total", "version", "updatedAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "organizationId": { "type": "string", "format": "uuid" }, "propertyId": { "type": "string", "format": "uuid" }, "roomId": { "type": "string", "format": "uuid" }, "guest": { "$ref": "#/components/schemas/GuestSummary" }, "checkIn": { "type": "string", "format": "date" }, "checkOut": { "type": "string", "format": "date" }, "adults": { "type": "integer", "minimum": 1, "maximum": 50 }, "children": { "type": "integer", "minimum": 0, "maximum": 50 }, "status": { "enum": ["confirmed", "checked-in", "checked-out", "cancelled", "no-show"] }, "total": { "$ref": "#/components/schemas/Money" }, "version": { "type": "integer", "minimum": 1 }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "CreateReservationCommand": { "type": "object", "additionalProperties": false, "required": ["propertyId", "roomId", "guestId", "checkIn", "checkOut", "adults", "quoteId"], "properties": { "propertyId": { "type": "string", "format": "uuid" }, "roomId": { "type": "string", "format": "uuid" }, "guestId": { "type": "string", "format": "uuid" }, "checkIn": { "type": "string", "format": "date" }, "checkOut": { "type": "string", "format": "date" }, "adults": { "type": "integer", "minimum": 1, "maximum": 50 }, "children": { "type": "integer", "minimum": 0, "maximum": 50, "default": 0 }, "quoteId": { "type": "string", "format": "uuid" } } },
      "RoomPage": { "type": "object", "additionalProperties": false, "required": ["data", "nextCursor"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Room" } }, "nextCursor": { "type": ["string", "null"] } } },
      "ReservationPage": { "type": "object", "additionalProperties": false, "required": ["data", "nextCursor"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Reservation" } }, "nextCursor": { "type": ["string", "null"] } } },
      "ApiError": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message", "requestId"], "properties": { "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" }, "message": { "type": "string", "minLength": 1, "maxLength": 500 }, "requestId": { "type": "string", "format": "uuid" }, "details": { "type": "object", "additionalProperties": true } } } } }
      ,"AuthUser": { "type": "object", "additionalProperties": false, "required": ["id", "organizationId", "propertyId", "displayName", "role", "sessionId"], "properties": { "id": { "type": "string", "format": "uuid" }, "organizationId": { "type": "string", "format": "uuid" }, "propertyId": { "type": "string", "format": "uuid" }, "displayName": { "type": "string" }, "role": { "enum": ["owner", "manager", "front-desk", "housekeeping"] }, "sessionId": { "type": "string", "format": "uuid" } } }
      ,"LoginRequest": { "type": "object", "additionalProperties": false, "required": ["email", "password", "propertyId", "clientType", "deviceName"], "properties": { "email": { "type": "string", "format": "email", "maxLength": 254 }, "password": { "type": "string", "minLength": 1, "maxLength": 128 }, "propertyId": { "type": "string", "format": "uuid" }, "clientType": { "enum": ["native", "web"] }, "deviceName": { "type": "string", "minLength": 1, "maxLength": 160 }, "mfaCode": { "type": "string", "pattern": "^\\d{6}$" } } }
      ,"RefreshRequest": { "type": "object", "additionalProperties": false, "required": ["clientType"], "properties": { "clientType": { "enum": ["native", "web"] }, "refreshToken": { "type": "string", "minLength": 32, "maxLength": 512 } } }
      ,"AuthResponse": { "type": "object", "additionalProperties": false, "required": ["user", "accessExpiresInSeconds"], "properties": { "user": { "$ref": "#/components/schemas/AuthUser" }, "accessExpiresInSeconds": { "type": "integer", "const": 300 }, "accessToken": { "type": "string" }, "refreshToken": { "type": "string" }, "refreshExpiresAt": { "type": "string", "format": "date-time" } } }
      ,"PasswordResetRequest": { "type": "object", "additionalProperties": false, "required": ["email", "propertyId"], "properties": { "email": { "type": "string", "format": "email" }, "propertyId": { "type": "string", "format": "uuid" } } }
      ,"PasswordResetConfirm": { "type": "object", "additionalProperties": false, "required": ["token", "newPassword"], "properties": { "token": { "type": "string", "minLength": 32, "maxLength": 512 }, "newPassword": { "type": "string", "minLength": 12, "maxLength": 128 } } }
      ,"NotificationPreviewRequest": { "type": "object", "additionalProperties": false, "required": ["eventType", "channel", "locale", "variables"], "properties": { "eventType": { "enum": ["reservation.confirmed", "reservation.changed", "arrival.reminder", "task.assigned", "task.blocked"] }, "channel": { "enum": ["email", "push"] }, "locale": { "enum": ["en", "fr", "ar"] }, "variables": { "type": "object", "additionalProperties": { "type": "string" } } } }
      ,"NotificationPreview": { "type": "object", "additionalProperties": false, "required": ["templateId", "version", "locale", "subject", "body"], "properties": { "templateId": { "type": "string", "format": "uuid" }, "version": { "type": "integer" }, "locale": { "enum": ["en", "fr", "ar"] }, "subject": { "type": "string" }, "body": { "type": "string" } } }
      ,"NotificationEventRequest": { "type": "object", "additionalProperties": false, "required": ["eventId", "eventType", "recipient", "variables"], "properties": { "eventId": { "type": "string", "format": "uuid" }, "eventType": { "enum": ["reservation.confirmed", "reservation.changed", "arrival.reminder", "task.assigned", "task.blocked"] }, "recipient": { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "enum": ["user", "guest"] }, "id": { "type": "string", "format": "uuid" }, "email": { "type": "string", "format": "email" }, "pushToken": { "type": "string" } } }, "variables": { "type": "object", "additionalProperties": { "type": "string" } } } }
      ,"NotificationPreferences": { "type": "object", "additionalProperties": false, "required": ["locale", "emailEnabled", "pushEnabled", "arrivalReminders", "quietStart", "quietEnd", "timezone", "urgentBypass", "unsubscribedAt"], "properties": { "locale": { "enum": ["en", "fr", "ar"] }, "emailEnabled": { "type": "boolean" }, "pushEnabled": { "type": "boolean" }, "arrivalReminders": { "type": "boolean" }, "quietStart": { "type": "string" }, "quietEnd": { "type": "string" }, "timezone": { "type": "string" }, "urgentBypass": { "type": "boolean" }, "unsubscribedAt": { "type": ["string", "null"], "format": "date-time" } } }
      ,"NotificationCallback": { "type": "object", "additionalProperties": false, "required": ["id", "messageId", "status"], "properties": { "id": { "type": "string" }, "messageId": { "type": "string" }, "status": { "enum": ["delivered", "bounced", "failed"] } } }
    }
  }
}
