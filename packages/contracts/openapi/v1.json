{
  "openapi": "3.1.0",
  "info": {
    "title": "KEYORA StayOS API",
    "version": "1.0.0",
    "description": "Versioned, tenant-scoped contract shared by native and web clients."
  },
  "servers": [{ "url": "/", "description": "Environment-relative; origins are configured outside the contract." }],
  "security": [{ "session": [] }],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "security": [],
        "responses": { "200": { "description": "Process health", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } } }
      }
    },
    "/v1/ready": {
      "get": {
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": { "description": "Dependencies are ready to receive traffic", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadinessResponse" } } } },
          "503": { "description": "One or more dependencies are unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadinessResponse" } } } }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "login",
        "security": [],
        "x-idempotency-exempt": true,
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "Authenticated; web tokens are set only as HttpOnly cookies", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "security": [],
        "x-idempotency-exempt": true,
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } } },
        "responses": { "200": { "description": "Rotated session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/auth/logout": {
      "post": { "operationId": "logout", "x-idempotency-exempt": true, "responses": { "204": { "description": "Session revoked and cookies cleared" } } }
    },
    "/v1/auth/password-reset/request": {
      "post": {
        "operationId": "requestPasswordReset", "security": [], "x-idempotency-exempt": true,
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetRequest" } } } },
        "responses": { "202": { "description": "Always accepted to prevent account enumeration" } }
      }
    },
    "/v1/auth/password-reset/confirm": {
      "post": {
        "operationId": "confirmPasswordReset", "security": [], "x-idempotency-exempt": true,
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetConfirm" } } } },
        "responses": { "204": { "description": "Password replaced and every session revoked" }, "401": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/properties/{propertyId}/notifications/preview": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "post": { "operationId": "previewNotification", "x-idempotency-exempt": true, "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreviewRequest" } } } }, "responses": { "200": { "description": "Rendered without sending", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreview" } } } }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/properties/{propertyId}/notifications/events": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "post": { "operationId": "enqueueNotificationEvent", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationEventRequest" } } } }, "responses": { "202": { "description": "Event accepted idempotently" }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/properties/{propertyId}/notifications/deliveries": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "get": { "operationId": "listNotificationDeliveries", "responses": { "200": { "description": "Tenant-scoped redacted delivery history" }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/properties/{propertyId}/notification-preferences/me": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "get": { "operationId": "getMyNotificationPreferences", "responses": { "200": { "description": "Current user preferences", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreferences" } } } } } },
      "put": { "operationId": "updateMyNotificationPreferences", "x-idempotency-exempt": true, "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationPreferences" } } } }, "responses": { "204": { "description": "Preferences updated" } } }
    },
    "/v1/notification-providers/primary/callback": {
      "post": { "operationId": "receiveNotificationCallback", "security": [], "x-idempotency-exempt": true, "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationCallback" } } } }, "responses": { "204": { "description": "Authenticated callback accepted idempotently" }, "401": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/properties/{propertyId}/rooms": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "get": {
        "operationId": "listRooms",
        "responses": {
          "200": { "description": "Property-scoped rooms", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoomPage" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/properties/{propertyId}/reservations": {
      "parameters": [{ "$ref": "#/components/parameters/PropertyId" }],
      "get": {
        "operationId": "listReservations",
        "responses": {
          "200": { "description": "Property-scoped reservations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReservationPage" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createReservation",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateReservationCommand" } } } },
        "responses": {
          "201": { "description": "Reservation created exactly once", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reservation" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    }
    ,"/v1/properties/{propertyId}/housekeeping/tasks": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }], "get": { "operationId": "listHousekeepingTasks", "parameters": [{ "name": "cursor", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }, { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["ready", "in-progress", "blocked", "inspection", "done"] } }, { "name": "priority", "in": "query", "required": false, "schema": { "type": "string", "enum": ["normal", "rush"] } }, { "name": "roomId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } }, { "name": "assigneeUserId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } }, { "name": "overdue", "in": "query", "required": false, "schema": { "type": "string", "enum": ["true", "false"] } }], "responses": { "200": { "description": "Rush first, then by due window", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingTaskPage" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }, "post": { "operationId": "createHousekeepingTask", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateHousekeepingTaskCommand" } } } }, "responses": { "201": { "description": "Task created with default checklist", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingTaskDetail" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/housekeeping/tasks/{taskId}": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "get": { "operationId": "getHousekeepingTask", "responses": { "200": { "description": "Task with checklist and recent inspections", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingTaskDetail" } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/housekeeping/tasks/{taskId}/assign": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "patch": { "operationId": "assignHousekeepingTask", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssignHousekeepingTaskCommand" } } } }, "responses": { "200": { "description": "Assigned", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingTaskDetail" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/housekeeping/tasks/{taskId}/checklist": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "post": { "operationId": "addHousekeepingChecklistItem", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddChecklistItemCommand" } } } }, "responses": { "201": { "description": "Item added", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingChecklistItem" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/housekeeping/tasks/{taskId}/checklist/{itemId}": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "itemId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "patch": { "operationId": "toggleHousekeepingChecklistItem", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ToggleChecklistItemCommand" } } } }, "responses": { "200": { "description": "Item toggled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingChecklistItem" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/housekeeping/tasks/{taskId}/transitions": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "post": { "operationId": "transitionHousekeepingTask", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingTransitionCommand" } } } }, "responses": { "200": { "description": "Valid state-machine transition applied", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingTaskDetail" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/housekeeping/tasks/{taskId}/inspections": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "post": { "operationId": "inspectHousekeepingTask", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingInspectionCommand" } } } }, "responses": { "200": { "description": "Inspection recorded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingTaskDetail" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/housekeeping/tasks/{taskId}/escalate": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "post": { "operationId": "escalateHousekeepingTask", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingEscalationCommand" } } } }, "responses": { "200": { "description": "Maintenance block opened and task blocked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HousekeepingTaskDetail" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/rooms/{roomId}": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "roomId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "get": { "operationId": "getRoom", "responses": { "200": { "description": "Room", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Room" } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } }, "patch": { "operationId": "updateRoom", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoomStatusCommand" } } } }, "responses": { "200": { "description": "Updated room (409 ROOM_NOT_READY while a housekeeping turn is open)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Room" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/rooms/bulk": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }], "patch": { "operationId": "bulkUpdateRooms", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BulkRoomCommand" } } } }, "responses": { "200": { "description": "Rooms updated", "content": { "application/json": { "schema": { "type": "object" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/rooms/reorder": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }], "post": { "operationId": "reorderRooms", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReorderRoomsCommand" } } } }, "responses": { "200": { "description": "Rooms reordered", "content": { "application/json": { "schema": { "type": "object" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/reservations/{reservationId}": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "reservationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "get": { "operationId": "getReservation", "responses": { "200": { "description": "Reservation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reservation" } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/reservations/{reservationId}/transitions": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "reservationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "post": { "operationId": "transitionReservation", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReservationTransitionCommand" } } } }, "responses": { "200": { "description": "Lifecycle transition applied; check-out creates one room-turn task", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reservation" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/guests": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }], "get": { "operationId": "listGuests", "parameters": [{ "name": "q", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 160 } }, { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }, { "name": "cursor", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } }], "responses": { "200": { "description": "Guests; contact fields masked without guest:sensitive", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestPage" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }, "post": { "operationId": "createGuest", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateGuestCommand" } } } }, "responses": { "201": { "description": "Guest created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Guest" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/quotes": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }], "post": { "operationId": "createQuote", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateQuoteCommand" } } } }, "responses": { "201": { "description": "Signed quote valid for 15 minutes", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Quote" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/maintenance-blocks": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }], "get": { "operationId": "listMaintenanceBlocks", "responses": { "200": { "description": "Latest 200 blocks", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MaintenanceBlock" } } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } }, "post": { "operationId": "createMaintenanceBlock", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateMaintenanceBlockCommand" } } } }, "responses": { "201": { "description": "Room blocked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MaintenanceBlock" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } }
    ,"/v1/properties/{propertyId}/maintenance-blocks/{blockId}/release": { "parameters": [{ "$ref": "#/components/parameters/PropertyId" }, { "name": "blockId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "post": { "operationId": "releaseMaintenanceBlock", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "Block released", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MaintenanceBlock" } } } }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": {
      "session": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Native access token. Web uses an HttpOnly session cookie with the same authorization claims." }
    },
    "parameters": {
      "PropertyId": { "name": "propertyId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "Error": { "description": "Safe error envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
    },
    "schemas": {
